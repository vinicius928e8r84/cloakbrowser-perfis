  "autoria": {
    "emails_do_dono": [
      "48294278+vinicius928e8r84@users.noreply.github.com"
    ],
    "emails_de_commit_aceitos": [
      "noreply@github.com"
    ],
    "por_ramo": [
      {
        "prefixo": "dependabot/github_actions/",
        "autor_da_pr": "dependabot[bot]",
        "emails": [
          "49699333+dependabot[bot]@users.noreply.github.com"
        ]
      }
    ]
  },
  "ferramentas": [
    {
      "nome": "ruff",
      "quando_existe": [
        "scripts/freios/ruff.toml"
      ],
      "comando": [
        "ruff",
        "check",
        "--no-cache",
        "--config",
        "scripts/freios/ruff.toml"
      ],
      "alvo_tudo": [
        "."
      ],
      "extensoes": [
        ".py"
      ]
    },
    {
      "nome": "eslint",
      "quando_existe": [
        "scripts/freios/eslint.config.mjs"
      ],
      "comando": [
        "npx",
        "--prefix",
        "scripts/freios",
        "eslint",
        "--config",
        "scripts/freios/eslint.config.mjs"
      ],
      "alvo_tudo": [
        "frontend/src"
      ],
      "extensoes": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs"
      ],
      "instalado_em": "scripts/freios/node_modules",
      "instalar": "npm ci --prefix scripts/freios"
    }
  ],
  "catraca": {
    "verificacoes": [
      "tamanho",
      "comentarios",
      "dados_pessoais"
    ]
  }
}
